# Full compatible package repository for ImmortalWrt 25.12.2 OneCloud tools.
CONFIG_TARGET_amlogic=y
CONFIG_TARGET_amlogic_meson8b=y
CONFIG_TARGET_amlogic_meson8b_DEVICE_thunder-onecloud=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=600
CONFIG_TARGET_ROOTFS_EXT4FS=y
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# Select all compatible userspace packages and kernel modules from pinned feeds.
# Extra packages are built as modules (m), not all installed into the rootfs.
CONFIG_ALL=y
CONFIG_ALL_KMODS=y
CONFIG_ALL_NONSHARED=y
# CONFIG_BROKEN is not set

# Bundle all built packages in the standalone ImageBuilder.
CONFIG_IB=y
CONFIG_IB_STANDALONE=y
CONFIG_SDK=y

# Cache repeated compiler invocations.
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_AUTOREMOVE=y
